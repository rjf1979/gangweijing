# 管理后台服务端口（默认 3216）
PORT=3216
# 监听地址（默认 127.0.0.1）
HOST=127.0.0.1

# 数据库连接（与主项目 server/.env 保持一致）
# 本地开发：
DATABASE_URL_LOCAL=postgres://user:password@127.0.0.1:5432/job_mirror
# 服务器生产：
# DATABASE_URL_SERVER=postgres://user:password@host:5432/job_mirror
# 或直接指定：
# DATABASE_URL=postgres://user:password@127.0.0.1:5432/job_mirror
# 与主项目一致的数据库选择模式（local / server，默认 local）
APP_URL_MODE=local

# 首次启动自动创建初始管理员（仅当 admin_users 表为空时生效）
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_PASSWORD=change-me-please

# 可选：查看当前 AI / 邮件服务配置状态（只读展示，不存储密钥）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
RESEND_API_KEY=
EMAIL_FROM=